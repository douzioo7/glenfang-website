---
import { site } from '../config/site';

const endpoint = import.meta.env.PUBLIC_TWIKOO_ENV_ID?.trim() || site.comments.endpoint;
interface Props { path?: string; title?: string; }
const { path: commentPath = Astro.url.pathname, title = '留下一句话' } = Astro.props;
---

{site.comments.enabled && endpoint && (
  <section class="comments" aria-label="评论区">
    <p class="eyebrow">CONVERSATION</p>
    <h2>{title}</h2>
    <p id="comment-status" class="comment-status" role="status">正在加载评论…</p>
    <div id="comment-recovery" hidden>
      <button type="button" onclick="window.location.reload()">重新加载</button>
      {site.contact.email && <a href={`mailto:${site.contact.email}`}>也可以写邮件给我 ↗</a>}
    </div>
    <noscript>请启用 JavaScript 后查看或发表评论。</noscript>
    <div id="twikoo" data-endpoint={endpoint} data-path={commentPath}></div>
    <script is:inline>
      (() => {
        const mount = document.querySelector('#twikoo');
        const status = document.querySelector('#comment-status');
        const recovery = document.querySelector('#comment-recovery');
        if (!mount || !status) return;

        const showError = () => {
          status.hidden = false;
          status.textContent = '评论暂时无法加载，请稍后刷新页面重试。';
          if (recovery) recovery.hidden = false;
        };
        const timeout = window.setTimeout(showError, 15000);
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.20/dist/twikoo.min.js';
        script.async = true;
        script.onload = async () => {
          try {
            await window.twikoo.init({
              envId: mount.dataset.endpoint,
              el: '#twikoo',
              path: mount.dataset.path,
              lang: 'zh-CN',
            });
            status.hidden = true;
            if (recovery) recovery.hidden = true;
          } catch {
            showError();
          } finally {
            window.clearTimeout(timeout);
          }
        };
        script.onerror = () => {
          window.clearTimeout(timeout);
          showError();
        };
        document.head.append(script);
      })();
    </script>
  </section>
)}

<style>
  .comment-status { color: var(--muted); font-size: 1rem; }
  #comment-recovery { margin-bottom: 20px; }
  #comment-recovery button { margin-right: 16px; padding: 7px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--ink); cursor: pointer; }
  #comment-recovery a { text-decoration: underline; font-size: .9rem; }
  .comments :global(.twikoo) { color: var(--ink); }
  .comments { margin-top: 76px; padding-top: 42px; border-top: 1px solid var(--line); }.comments h2 { margin: 0 0 26px; font-family: Georgia, "Noto Serif SC", serif; font-size: 1.8rem; font-weight: 400; }
</style>
